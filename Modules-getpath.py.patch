     DELIM = ';'
     SEP = '\\'
 
+elif os_name == 'amigaos':
+    # AmigaOS uses ':' inside volume paths (DH1:foo), so it can't
+    # double as a PYTHONPATH delimiter the way it does on POSIX.
+    # Use ';' like Windows. SEP is '/' — Amiga accepts either dir
+    # separator once we're past the volume name. Layout mirrors
+    # the flat Windows convention (no `lib/` subdir), since we
+    # ship python312.zip and everything else in one dir.
+    BUILDDIR_TXT = 'pybuilddir.txt'
+    BUILD_LANDMARK = 'Modules/Setup.local'
+    DEFAULT_PROGRAM_NAME = f'python{VERSION_MAJOR}'
+    STDLIB_SUBDIR = 'lib'
+    STDLIB_LANDMARKS = [f'{STDLIB_SUBDIR}/os.py', f'{STDLIB_SUBDIR}/os.pyc']
+    PLATSTDLIB_LANDMARK = f'{STDLIB_SUBDIR}/lib-dynload'
+    BUILDSTDLIB_LANDMARKS = ['Lib/os.py']
+    VENV_LANDMARK = 'pyvenv.cfg'
+    ZIP_LANDMARK = f'python{VERSION_MAJOR}{VERSION_MINOR}.zip'
+    DELIM = ';'
+    SEP = '/'
+
 
