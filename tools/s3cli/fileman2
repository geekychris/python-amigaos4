.KEY LEFT/K,RIGHT/K
.BRA {
.KET }
.def LEFT RAM:
.def RIGHT s3://
;
; fileman2 — one-line launcher for the ReAction dual-pane file
; manager pointed at the local MinIO on the host.
;
; Usage:
;   execute DH1:s3cli/fileman2
;                        — RAM: on left, s3:// buckets on right
;   execute DH1:s3cli/fileman2 LEFT=DH1: RIGHT=s3://test
;                        — override either pane's starting path
;
; Installs the S3 env from s3-env-local, sets FILEMAN2_LEFT/RIGHT,
; and runs the Python program. `run` detaches so the shell frees.

execute DH1:s3cli/s3-env-local

; Correct for the OS4 Python time-skew (newlib treats Amiga wall clock
; as local, so time.time() is off by the TZ offset — SigV4 refuses
; requests >5 min skewed). 14400 = 4h EDT correction. See
; os4_clock_gotcha.md — permanent fix wants a python-os4 rebuild.
setenv S3_TIME_SKEW 14400

setenv FILEMAN2_LEFT  {LEFT}
setenv FILEMAN2_RIGHT {RIGHT}

echo "fileman2: launching (left={LEFT} right={RIGHT})"
echo "fileman2: log at RAM:fm2.log — 'type RAM:fm2.log' after actions"
run >RAM:fm2.log DH1:python-os4 DH1:pytests/examples/fileman2.py
