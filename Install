; AmigaOS 4 Installation Utility Script for Python 3.12.7
; Used by SYS:Utilities/Installation Utility

(language "english")

(welcome
  (text "Welcome to the Python 3.12.7 for AmigaOS 4.1 Installer.\n\n"
        "This installer will setup Python 3 on your AmigaOS 4 system:\n"
        "  1. Install executable to C:python3\n"
        "  2. Install main library files to SYS:System/python3\n"
        "  3. Configure 'Assign python3: SYS:System/python3' in S:User-Startup\n"
        "  4. Set persistent environment variables (PYTHONHOME & PYTHONPATH)\n\n"
        "Click Proceed to start installation.")
)

(set #target-c "C:")
(set #target-sys "SYS:System/python3")

(message "Step 1: Installing command executable to C:...")

(copyfiles
  (prompt "Copying python3 executable to C:")
  (source "C/python3")
  (dest #target-c)
  (help "Installs the python3 executable into your C: command directory.")
)

(message "Step 2: Installing Python 3 system files...")

(copydirs
  (prompt "Copying Python 3 system files to SYS:System/python3...")
  (source "System/python3")
  (dest #target-sys)
  (help "Copies the Python 3 standard library, Amiga bindings, examples, and documentation.")
)

(message "Step 3: Configuring assignment and environment variables...")

(if (askbool
      (prompt "Would you like to add 'Assign python3: SYS:System/python3' to S:User-Startup and save environment variables?")
      (default 1)
      (help "Adds 'Assign python3: SYS:System/python3' to S:User-Startup and sets persistent PYTHONHOME and PYTHONPATH environment variables.")
    )
    (all
      (run "SetEnv PYTHONHOME SAVE python3:")
      (run "SetEnv PYTHONPATH SAVE python3:lib")
      (startup "python3"
        (prompt "Adding 'Assign python3: SYS:System/python3' to S:User-Startup...")
        (command "; --- Python 3.12.7 for AmigaOS 4 ---\nAssign python3: SYS:System/python3\n; --- End Python 3 ---\n")
      )
    )
)

(message "Installation of Python 3.12.7 completed successfully!\n\nYou can now open a Shell and run:\n  python3 --version")
