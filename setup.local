# CPython Modules/Setup.local for the OS4 Phase-1/2 bootstrap.
# Copied into build-ppc-amigaos/Modules/Setup.local before make.
#
# Anything commented back in for Phase 2/3/4 stays as-is on rerun.

# ---- Force these C extensions into the interpreter as STATIC builtins ----
# Rationale: our loader has no dlopen equivalent yet, so .so extension
# modules are unreachable at import time.  Anything below rides in as part
# of python.exe itself.
*static*
math mathmodule.c
cmath cmathmodule.c
_datetime _datetimemodule.c
_json _json.c
_random _randommodule.c
_pickle _pickle.c
_heapq _heapqmodule.c
_bisect _bisectmodule.c
_struct _struct.c
_csv _csv.c
_contextvars _contextvarsmodule.c
_queue _queuemodule.c
_statistics _statisticsmodule.c
_opcode _opcode.c
_zoneinfo _zoneinfo.c
array arraymodule.c
select selectmodule.c
binascii binascii.c
unicodedata unicodedata.c
_socket socketmodule.c
zlib zlibmodule.c -lz
_amiga _amigamodule.c
_sqlite3 _sqlite/blob.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c -lsqlite3

# Hash primitives — no OpenSSL, pure-C fallbacks bundled with CPython.
# hashlib.py imports these by name; without them http.client's digest-auth
# path (used by urllib.request via html URLs) refuses to load.
# _sha3 + _blake2 skipped — sha3 pulls in the HACL* verified-crypto
# scaffolding (needs krml/types.h) which we don't have; nothing common
# actually calls hashlib.sha3_*() or hashlib.blake2* anyway.
_md5 md5module.c _hacl/Hacl_Hash_MD5.c -I$(srcdir)/Modules/_hacl/include -DPy_BUILD_CORE_BUILTIN
_sha1 sha1module.c _hacl/Hacl_Hash_SHA1.c -I$(srcdir)/Modules/_hacl/include -DPy_BUILD_CORE_BUILTIN
_sha2 sha2module.c _hacl/Hacl_Hash_SHA2.c -I$(srcdir)/Modules/_hacl/include -DPy_BUILD_CORE_BUILTIN

# _ssl and _hashopenssl: SDK OpenSSL uses AmiSSL's IAmiSSL interface
# pattern (SSL_CTX_new is a macro that expands to IAmiSSL->SSL_CTX_new()).
# Python's stock _ssl.c doesn't know about that indirection, so link
# fails with undefined refs to IAmiSSL. Would need either:
#   * an amissl-flavour OpenSSL SDK where symbols are direct calls, or
#   * a patched _ssl.c that opens amissl.library + calls through IAmiSSL.
# Parking this — pure-C _sha*/_md5 already unblocks hashlib.

# ---- Truly unsupported: no shims / no libs available yet ----
*disabled*
_posixsubprocess
_ssl
_hashlib
syslog
termios
grp
pwd
nis
spwd
resource
_multiprocessing
_posixshmem
_curses
_curses_panel
_dbm
_gdbm
_lzma
_tkinter
_bz2
audioop
ossaudiodev
mmap
fcntl
_crypt
readline
_ctypes
_decimal
_elementtree
pyexpat
_uuid
_asyncio
xxsubtype
