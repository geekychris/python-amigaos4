#!/usr/bin/env python3
"""install-Python3 — Python 3.12.7 Installer for AmigaOS 4"""
import os
import sys
import shutil

def main():
    print("==================================================")
    print(" Python 3.12.7 for AmigaOS 4.1 Installer")
    print("==================================================")
    print()

    target_sys = "SYS:System/python3"

    print("Step 1: Copying python3 executable to C:...")
    try:
        if os.path.exists("C/python3"):
            shutil.copy2("C/python3", "C:/python3")
            print("  -> Copied C/python3 -> C:python3")
    except Exception as e:
        print(f"  -> Warning copying to C:: {e}")

    print("Step 2: Copying Python 3 files to SYS:System/python3...")
    try:
        if os.path.exists("System/python3"):
            shutil.copytree("System/python3", target_sys, dirs_exist_ok=True)
            print("  -> Copied System/python3 -> SYS:System/python3")
    except Exception as e:
        print(f"  -> Warning copying library files: {e}")

    print("Step 3: Configuring persistent environment variables...")
    try:
        os.system("SetEnv PYTHONHOME SAVE python3:")
        os.system("SetEnv PYTHONPATH SAVE python3:lib")
        print("  -> Set persistent PYTHONHOME and PYTHONPATH in ENVARC:")
    except Exception as e:
        print(f"  -> Warning setting env vars: {e}")

    print("Step 4: Configuring assignment in S:User-Startup...")
    user_startup = "S:User-Startup"
    assign_line = "Assign python3: SYS:System/python3\n"

    try:
        need_add = True
        if os.path.exists(user_startup):
            with open(user_startup, "r", encoding="latin-1", errors="ignore") as f:
                if "python3:" in f.read():
                    need_add = False
                    print("  -> 'python3:' assign is already present in S:User-Startup")
        if need_add:
            with open(user_startup, "a", encoding="latin-1") as f:
                f.write("\n; --- Python 3.12.7 for AmigaOS 4 ---\n")
                f.write(assign_line)
                f.write("; --- End Python 3 ---\n")
            print("  -> Added 'Assign python3: SYS:System/python3' to S:User-Startup")
    except Exception as e:
        print(f"  -> Warning updating S:User-Startup: {e}")

    print()
    print("==================================================")
    print(" Installation of Python 3.12.7 complete!")
    print(" You can now run: python3 --version")
    print("==================================================")

if __name__ == "__main__":
    main()
