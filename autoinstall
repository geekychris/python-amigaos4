; AmigaOS 4 AutoInstall Script for Python 3.12.7
; Runs via AmigaDOS Execute command or double-clicking icon

FailAt 21

; Change working directory to the script's containing drawer
If EXISTS PROGDIR:
    CD PROGDIR:
EndIf

Echo "=========================================================="
Echo " AmigaOS 4.1 AutoInstall - Python 3.12.7"
Echo "=========================================================="
Echo ""

Echo "Step 1: Installing python3 binary to C:..."
If EXISTS C/python3
    Copy C/python3 C:python3 FORCE CLONE >NIL:
    If WARN
        Echo "  -> Notice: C:python3 is locked by a running process."
        Echo "     Stop running python processes to replace C:python3."
    Else
        Echo "  -> Installed C/python3 -> C:python3"
    EndIf
Else
    If EXISTS python3
        Copy python3 C:python3 FORCE CLONE >NIL:
        Echo "  -> Installed python3 -> C:python3"
    Else
        Echo "  -> Notice: python3 binary not found in script drawer."
    EndIf
EndIf

Echo ""
Echo "Step 2: Installing Python 3 system files to SYS:System/python3..."
If NOT EXISTS SYS:System/python3
    MakeDir SYS:System/python3 >NIL:
EndIf

If EXISTS System/python3
    Copy System/python3/#? SYS:System/python3/ ALL FORCE CLONE QUIET >NIL:
    If WARN
        Echo "  -> Notice: Some files in SYS:System/python3 are locked by a running Python task."
        Echo "     Stop active Python tasks to fully update the library tree."
    Else
        Echo "  -> Installed files into SYS:System/python3"
    EndIf
Else
    If EXISTS lib
        Copy #? SYS:System/python3/ ALL FORCE CLONE QUIET >NIL:
        Echo "  -> Installed files into SYS:System/python3"
    Else
        Echo "  -> Notice: System/python3 directory not found in script drawer."
    EndIf
EndIf

Echo ""
Echo "Step 3: Setting script protection bits on helper tools..."
If EXISTS SYS:System/python3/bin/pip3
    Protect SYS:System/python3/bin/pip3 +s +e >NIL:
    Echo "  -> Set script (+s) and execute (+e) bits on SYS:System/python3/bin/pip3"
EndIf
If EXISTS SYS:System/python3/bin/pip
    Protect SYS:System/python3/bin/pip +s +e >NIL:
    Echo "  -> Set script (+s) and execute (+e) bits on SYS:System/python3/bin/pip"
EndIf

Echo ""
Echo "Step 4: Setting persistent environment variables..."
SetEnv PYTHONHOME SAVE python3: >NIL:
SetEnv PYTHONPATH SAVE python3:lib;python3:lib/site-packages >NIL:
Echo "  -> Set persistent PYTHONHOME and PYTHONPATH in ENVARC:"

Echo ""
Echo "Step 5: Validating and configuring system assigns and path..."
If EXISTS python3:
    Echo "  -> Assign 'python3:' is active."
Else
    Assign python3: SYS:System/python3
    Echo "  -> Created assignment 'python3:' -> SYS:System/python3"
EndIf

If EXISTS S:User-Startup
    Echo "" >> S:User-Startup
    Echo "; --- Python 3.12.7 for AmigaOS 4 ---" >> S:User-Startup
    Echo "Assign python3: SYS:System/python3" >> S:User-Startup
    Echo "Path python3:bin ADD" >> S:User-Startup
    Echo "; --- End Python 3 ---" >> S:User-Startup
    Echo "  -> Added 'Assign python3:' and 'Path python3:bin ADD' to S:User-Startup"
EndIf

Echo ""
Echo "=========================================================="
Echo " Verification & Summary:"
If EXISTS C:python3
    Echo "  Python 3.12.7 binary : C:python3 [OK]"
Else
    Echo "  Python 3.12.7 binary : MISSING"
EndIf

Echo "  Python 3.12.7 home   : SYS:System/python3 [OK]"
Echo "  Python 3.12.7 bin    : SYS:System/python3/bin [OK]"
Echo ""
Echo " Installation Complete!"
Echo " Test installation by running in Shell: python3 --version"
Echo "=========================================================="
